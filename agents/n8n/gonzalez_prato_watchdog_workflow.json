{
  "name": "Watchdog Autónomo — Autoreparación Socket WhatsApp (GONZALEZ-PRATO)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "e1a10001-watchdog-trigger-15min",
      "name": "Cron Watchdog Cada 15 Minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://86.48.20.190:8080/instance/connectionState/gonzalez-prato",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "GonzalezPratoSecret2026"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 10000
        }
      },
      "id": "e1a10002-check-socket-state",
      "name": "Consultar Estado Socket en Evolution API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Evaluador inteligente de estado de red y ventanas de prevención de socket zombie\nconst item = $input.first();\nconst res = item.json || {};\nconst state = (res.instance && res.instance.state) || res.state || (res.error ? 'ERROR_CONEXION' : 'DESCONOCIDO');\n\nconst now = new Date();\nconst vzlaDate = new Date(now.toLocaleString('en-US', { timeZone: 'America/Caracas' }));\nconst currentHour = vzlaDate.getHours();\nconst currentMin = vzlaDate.getMinutes();\n\nlet needsRestart = false;\nlet reason = '';\n\nif (state !== 'open') {\n  needsRestart = true;\n  reason = `Alerta: Estado del socket no es 'open' (Actual: '${state}')`;\n} else if (currentHour === 6 && currentMin >= 45) {\n  needsRestart = true;\n  reason = 'Reinicio preventivo matutino (Preparación de sede 7:00 AM)';\n} else if (currentHour === 12 && currentMin <= 15) {\n  needsRestart = true;\n  reason = 'Reinicio preventivo de mediodía (Evitar congelamiento zombie por inactividad)';\n}\n\nreturn [{\n  json: {\n    state: state,\n    needsRestart: needsRestart,\n    reason: reason || 'Socket activo y saludable',\n    currentHour: currentHour,\n    currentMin: currentMin,\n    vzlaFormattedTime: vzlaDate.toLocaleTimeString('es-VE'),\n    evaluatedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "e1a10003-evaluar-salud-socket",
      "name": "Analizador Inteligente de Salud (Watchdog)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-needs-restart",
              "leftValue": "={{ $json.needsRestart }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e1a10004-if-needs-restart",
      "name": "¿Requiere Reinicio?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        940,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://86.48.20.190:8080/instance/restart/gonzalez-prato",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "GonzalezPratoSecret2026"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "e1a10005-restart-socket",
      "name": "Ejecutar Autoreparación (Restart Socket)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        220
      ]
    }
  ],
  "connections": {
    "Cron Watchdog Cada 15 Minutos": {
      "main": [
        [
          {
            "node": "Consultar Estado Socket en Evolution API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Consultar Estado Socket en Evolution API": {
      "main": [
        [
          {
            "node": "Analizador Inteligente de Salud (Watchdog)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analizador Inteligente de Salud (Watchdog)": {
      "main": [
        [
          {
            "node": "¿Requiere Reinicio?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Requiere Reinicio?": {
      "main": [
        [
          {
            "node": "Ejecutar Autoreparación (Restart Socket)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  }
}
